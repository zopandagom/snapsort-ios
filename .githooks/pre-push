#!/bin/bash
# main 으로 push 하는 것을 push 전에 막는다 (make bootstrap 이 연결). 서버에서는 GitHub 룰셋 `main 보호`(PR 필수)가 막는다.
# 우회가 꼭 필요하면: git push --no-verify
while read -r _ _ remote_ref _; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "main 으로 직접 push 할 수 없습니다. PR 로 머지하세요." >&2
    exit 1
  fi
done
exit 0
